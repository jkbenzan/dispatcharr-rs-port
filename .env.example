DATABASE_URL=postgres://dispatcharr:dispatcharr@postgres.example.com:5432/dispatcharr

# Legacy feature guard. Leave disabled for normal provider-scale operation.
DISPATCHARR_ENABLE_LEGACY_AUTO_CHANNEL_SYNC=false
DISPATCHARR_AUTO_CHANNEL_SYNC_LIMIT=100
PORT=8080

# Storage location for downloaded VOD posters. Can be mapped to a separate volume.
VOD_IMAGE_DIR=./data/vod_images/
